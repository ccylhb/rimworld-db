---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import food from "../../data/rimworld_food.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";

export function getStaticPaths() {
  return food.map((x: any) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props as any;
const f = x.fields || {};
const similar = food
  .filter((o: any) => o.slug !== x.slug && (o.fields?.["food type"] || "") === (f["food type"] || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://rimworld-db.pages.dev/" },
      { "@type": "ListItem", position: 2, name: "Food", item: "https://rimworld-db.pages.dev/food/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: "https://rimworld-db.pages.dev" + "/food/" + __slug + "/",
  },
];
---
<Base
  title={`${x.title} — RimWorld food stats (nutrition ${f.nutrition || "?"})`}
  description={`${x.title}: ${f.nutrition || "?"} nutrition${f["days to rot"] ? `, ${f["days to rot"]} days to rot` : ""} — RimWorld food values.`}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {f.description && <p class="muted">{f.description}</p>}
  <EntryStats entry={x} keys={["nutrition", "days to rot", "marketvalue", "mass base", "stack limit"]} labels={{ nutrition: "Nutrition", "days to rot": "Days to rot", marketvalue: "Value (¤)", "mass base": "Mass (kg)", "stack limit": "Stack limit" }} />
  <p>
    {f["food type"] && <span class="tag" style="margin:0.1rem">{f["food type"]}</span>}
    {f.taste && <span class="tag" style="margin:0.1rem">{f.taste}</span>}
    {f.preferability && <span class="tag" style="margin:0.1rem">{f.preferability}</span>}
  </p>
  {ihtml && <p set:html={ihtml}></p>}
  <Related
    links={[
      ...similar.map((s: any) => ({
        href: `/food/${s.slug}/`,
        title: s.title,
        sub: `Nutrition ${s.fields?.nutrition || "?"}`,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/food/", title: "All Food", sub: "Sortable nutrition table" },
      { href: "/plants/", title: "Plants", sub: "Grow times & yields" },
    
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
